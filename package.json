{
  "name": "pi-formula",
  "version": "0.1.1",
  "description": "Readable LaTeX in Pi: terminal-native inline math and MathJax display images.",
  "license": "MIT",
  "author": "Yasuhito Takamiya <yasuhito@hey.com> (https://github.com/yasuhito)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yasuhito/pi-formula.git"
  },
  "homepage": "https://github.com/yasuhito/pi-formula#readme",
  "bugs": {
    "url": "https://github.com/yasuhito/pi-formula/issues"
  },
  "keywords": [
    "pi-package",
    "latex",
    "mathjax",
    "terminal"
  ],
  "type": "commonjs",
  "main": "./dist/api.js",
  "types": "./dist/api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    }
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "image": "https://raw.githubusercontent.com/yasuhito/pi-formula/main/assets/ghostty-formulas.png"
  },
  "files": [
    "src/",
    "dist/",
    "assets/ghostty-formulas.png",
    "README.md",
    "README.ja.md",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/clean-dist.js && tsc",
    "prepack": "npm run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "knip": "node scripts/clean-tools.ts --analyze-sources && knip && node scripts/clean-dist.ts --tools",
    "complexity": "npm run build:tools --silent && node scripts/check-complexity.js",
    "check:test-assertions": "npm run build:tools --silent && node scripts/check-test-assertions.js",
    "automation:resolve-review-report": "node scripts/resolve-review-report.ts",
    "check:package": "npm run build && publint && attw --pack .",
    "typecheck": "tsc && tsc -p tsconfig.tools.json --noEmit && npm run typecheck:steps",
    "test:unit": "npm run build:tools && node --test test/*.test.js",
    "coverage": "npm run build:tools && node --test --experimental-test-coverage --test-coverage-include=\"dist/*.js\" --test-coverage-lines=80 --test-coverage-branches=70 --test-coverage-functions=80 test/*.test.js",
    "test:cucumber": "npm run build:tools && cucumber-js --require \"features/step_definitions/**/*.ts\" --format progress \"features/**/*.feature.md\"",
    "test:native-vt": "npm run build:tools && cucumber-js --require \"features/step_definitions/**/*.ts\" --format progress --tags \"@native-vt\" \"features/native-protocol.feature.md\"",
    "test": "npm run coverage && npm run test:cucumber",
    "check": "npm run lint && npm run typecheck && npm run knip && npm run complexity && npm run check:test-assertions && npm run check:package && npm test",
    "verify:vt": "node scripts/run-vt-pty.js",
    "verify:display": "npm run build:tools --silent >/dev/null && node scripts/verify-display.js",
    "verify:encoder-protocol": "npm run build && node scripts/verify-encoder-protocol.js",
    "verify:pi-protocol": "npm run build:tools --silent && node scripts/verify-pi-protocol.js",
    "verify:streaming-protocol": "npm run build && node scripts/verify-streaming-protocol.js",
    "verify:session-record": "npm run build:tools --silent && node scripts/verify-session-tools.js",
    "release:prepare": "npm run check && node scripts/prepare-release.js",
    "build:tools": "npm run build",
    "postbuild": "node scripts/clean-dist.js --tools",
    "typecheck:steps": "tsc -p tsconfig.steps.json --noEmit"
  },
  "dependencies": {
    "@mathjax/src": "^4.1.3",
    "@resvg/resvg-js": "^2.6.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.15",
    "@cucumber/cucumber": "^13.2.1",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "@types/node": "^26.4.1",
    "diff": "9.0.0",
    "estree-walker": "3.0.3",
    "knip": "6.39.0",
    "oxc-parser": "0.152.0",
    "oxlint-plugin-complexity": "3.0.1",
    "publint": "0.3.25",
    "typescript": "^7.0.2"
  }
}
