{
  "name": "pi-formula",
  "version": "0.1.0",
  "description": "Readable LaTeX in Pi: terminal-native inline math and MathJax display images.",
  "license": "MIT",
  "author": "Yasuhito Takamiya <yasuhito@hey.com> (https://github.com/yasuhito)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yasuhito/pi-formula.git"
  },
  "homepage": "https://github.com/yasuhito/pi-formula#readme",
  "bugs": {
    "url": "https://github.com/yasuhito/pi-formula/issues"
  },
  "keywords": [
    "pi-package",
    "latex",
    "mathjax",
    "terminal"
  ],
  "type": "commonjs",
  "main": "./dist/api.js",
  "types": "./dist/api.d.ts",
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "image": "https://raw.githubusercontent.com/yasuhito/pi-formula/main/assets/ghostty-formulas.png"
  },
  "files": [
    "src/",
    "dist/",
    "assets/ghostty-formulas.png",
    "README.md",
    "README.ja.md",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check:package": "npm run build && publint && attw --pack .",
    "typecheck": "tsc --noEmit",
    "test:unit": "npm run build && node --test test/*.test.js",
    "test:cucumber": "npm run build && cucumber-js --require \"features/step_definitions/**/*.js\" --format progress \"features/**/*.feature.md\"",
    "test": "npm run test:unit && npm run test:cucumber",
    "check": "npm run lint && npm run typecheck && npm run check:package && npm test",
    "release:prepare": "npm run check && node scripts/prepare-release.js"
  },
  "dependencies": {
    "@mathjax/src": "^4.1.3",
    "@resvg/resvg-js": "^2.6.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.11",
    "@cucumber/cucumber": "^13.2.1",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "@types/node": "^25.6.0",
    "publint": "0.3.24",
    "typescript": "^6.0.3"
  }
}
