#!/usr/bin/env bash
set -uo pipefail

MODE=${1:-}
LABEL=${2:-}
shift 2 || true
[[ "$MODE" == infrastructure || "$MODE" == detector || "$MODE" == poll ]] || {
  printf 'Usage: run-display-command <infrastructure|detector|poll> <label> <command> [args...]\n' >&2
  exit 2
}
[[ -n "$LABEL" && $# -gt 0 ]] || {
  printf 'run-display-command: label または command がありません\n' >&2
  exit 2
}

"$@"
status=$?
if [[
  "$status" -eq 0 ||
    ("$status" -eq 1 && ("$MODE" == detector || "$MODE" == poll))
]]; then
  exit "$status"
fi
printf 'verify-display: %s が終了コード %s で失敗しました\n' "$LABEL" "$status" >&2
exit 2
