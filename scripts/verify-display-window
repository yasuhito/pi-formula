#!/usr/bin/env bash
set -Eeuo pipefail

COMMAND_TIMEOUT=3
TITLE=${1:-}
MONITOR=${2:-}
EXPECTED_ADDRESS=${3:-}
EXPECTED_WIDTH=${4:-}
EXPECTED_HEIGHT=${5:-}

[[ -n "$TITLE" && "$MONITOR" =~ ^-?[0-9]+$ ]] || {
  printf 'Usage: verify-display-window <title> <monitor-id> [expected-address [width height]]\n' >&2
  exit 2
}
[[ -z "$EXPECTED_WIDTH$EXPECTED_HEIGHT" || ("$EXPECTED_WIDTH" =~ ^[1-9][0-9]*$ && "$EXPECTED_HEIGHT" =~ ^[1-9][0-9]*$) ]] || {
  printf '検証ウィンドウの期待寸法が不正です\n' >&2
  exit 2
}

run() {
  timeout --signal=TERM "$COMMAND_TIMEOUT" "$@"
}

window=$(run hyprctl clients -j | run jq -r \
  --arg title "$TITLE" --argjson monitor "$MONITOR" --arg address "$EXPECTED_ADDRESS" \
  --argjson width "${EXPECTED_WIDTH:-null}" --argjson height "${EXPECTED_HEIGHT:-null}" '
  [.[] | select(
    .title == $title and
    .monitor == $monitor and
    ($address == "" or .address == $address) and
    ($width == null or (
      .size[0] >= ($width * 0.95 | floor) and .size[0] <= $width and
      .size[1] >= ($height * 0.95 | floor) and .size[1] <= $height
    ))
  )] |
  if length == 1 then
    if $width == null then .[0].address
    else "\(.[0].at[0]),\(.[0].at[1]) \(.[0].size[0])x\(.[0].size[1])"
    end
  else empty end')
if [[ -z "$window" ]]; then
  printf '検証ウィンドウが headless 出力の使用可能領域を占めていません\n' >&2
  exit 2
fi
printf '%s\n' "$window"
