#!/usr/bin/env bash
set -Eeuo pipefail

fail() {
  printf 'verify-display: %s\n' "$*" >&2
  exit 2
}

SESSION_ID=${XDG_SESSION_ID:-}
if [[ -z "$SESSION_ID" ]]; then
  sessions=$(loginctl list-sessions --no-legend --no-pager) \
    || fail "ログインセッションの一覧を取得できませんでした"
  fallback_session=
  while read -r candidate candidate_uid _; do
    [[ -n "$candidate" && "$candidate_uid" == "$UID" ]] || continue
    properties=$(loginctl show-session "$candidate" -p Type -p Class -p Active) \
      || continue
    [[ "$properties" == *"Class=user"* ]] || continue
    [[ -n "$fallback_session" ]] || fallback_session=$candidate
    if [[ "$properties" == *"Active=yes"* && \
      ("$properties" == *"Type=wayland"* || "$properties" == *"Type=x11"*) ]]; then
      SESSION_ID=$candidate
      break
    fi
  done <<<"$sessions"
  [[ -n "$SESSION_ID" ]] || SESSION_ID=$fallback_session
fi
[[ -n "$SESSION_ID" ]] \
  || fail "現在の利用者のログインセッションを解決できませんでした"

locked_hint=$(loginctl show-session "$SESSION_ID" -p LockedHint) \
  || fail "画面ロック状態を取得できませんでした: session=$SESSION_ID"
case "$locked_hint" in
  LockedHint=no) ;;
  LockedHint=yes)
    fail "画面がロックされています。ロック解除後に実表示検証を再実行してください"
    ;;
  *) fail "画面ロック状態が不明です: session=$SESSION_ID" ;;
esac
