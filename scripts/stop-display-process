#!/usr/bin/env bash
set -Eeuo pipefail

COMMAND_TIMEOUT=3
PID=${1:-}
TITLE=${2:-}

[[ "$PID" =~ ^[1-9][0-9]*$ && -n "$TITLE" ]] || {
  printf 'Usage: stop-display-process <process-group-id> <window-title>\n' >&2
  exit 2
}

run() {
  timeout --signal=TERM "$COMMAND_TIMEOUT" "$@"
}

group_running() {
  local state
  local states
  states=$(run ps -o stat= -g "$PID" 2>/dev/null) || return 1
  while IFS= read -r state; do
    state=${state#"${state%%[![:space:]]*}"}
    [[ -n "$state" && "$state" != Z* ]] && return 0
  done <<<"$states"
  return 1
}

run hyprctl dispatch "hl.dsp.window.close({ window = \"title:${TITLE}\" })" >/dev/null 2>&1 || true
kill -TERM -- "-$PID" >/dev/null 2>&1 || true
for _ in {1..4}; do
  group_running || break
  run sleep 0.25
done
if group_running; then
  kill -KILL -- "-$PID" >/dev/null 2>&1 || true
fi
for _ in {1..8}; do
  group_running || break
  run sleep 0.25
done
if group_running; then
  printf '検証 process group を停止できませんでした: %s\n' "$PID" >&2
  exit 2
fi

for _ in {1..8}; do
  clients=$(run hyprctl clients -j) || {
    printf '検証ウィンドウを照会できませんでした: %s\n' "$TITLE" >&2
    exit 2
  }
  count=$(printf '%s' "$clients" | run jq -r --arg title "$TITLE" \
    '[.[] | select(.title == $title)] | length') || {
    printf '検証ウィンドウを解析できませんでした: %s\n' "$TITLE" >&2
    exit 2
  }
  [[ "$count" -eq 0 ]] && exit 0
  run sleep 0.25
done
printf '検証ウィンドウが消えませんでした: %s\n' "$TITLE" >&2
exit 2
