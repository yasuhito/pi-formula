#!/usr/bin/env bash
set -Eeuo pipefail

COMMAND_TIMEOUT=8
BUILD_TIMEOUT=120
DETECTOR_TIMEOUT=30
SESSION_TIMEOUT=150
CAPTURE_READY_TIMEOUT=30
CAPTURE_READY_INTERVAL=2
IMAGE_PATH_TIMEOUT=30
IMAGE_PATH_INTERVAL_MS=1000
WINDOW_LIFETIME=270
SESSION_READY_TIMEOUT=30
WINDOW_TITLE="pi-formula-verify-$$"
SCRIPT_DIR=${BASH_SOURCE[0]%/*}
[[ "$SCRIPT_DIR" != "${BASH_SOURCE[0]}" ]] || SCRIPT_DIR=.
ROOT=$(cd -- "$SCRIPT_DIR/.." && pwd)
USAGE="Usage: scripts/verify-display [--theme <light|dark>] [--terminal <ghostty|kitty>] [--extension <path>] [--reflow <cols>] [--path <image|text>] <corpus.md>"
THEME=light
TERMINAL=ghostty
EXTENSION="$ROOT/src/extension.ts"
REFLOW=
DISPLAY_PATH=image
DESCRIBE=false
CORPUS=
ORIGINAL_ARGUMENTS="$*"

argument_error() {
  printf 'verify-display: 未対応の引数です: %s\n%s\n' "$*" "$USAGE" >&2
  exit 2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --describe)
      DESCRIBE=true
      shift
      ;;
    --theme)
      [[ $# -ge 2 ]] || argument_error "$1"
      THEME=$2
      shift 2
      ;;
    --terminal)
      [[ $# -ge 2 ]] || argument_error "$1"
      TERMINAL=$2
      shift 2
      ;;
    --extension)
      [[ $# -ge 2 ]] || argument_error "$1"
      EXTENSION=$2
      shift 2
      ;;
    --reflow)
      [[ $# -ge 2 ]] || argument_error "$1"
      REFLOW=$2
      shift 2
      ;;
    --path)
      [[ $# -ge 2 ]] || argument_error "$1"
      DISPLAY_PATH=$2
      shift 2
      ;;
    --*)
      argument_error "$ORIGINAL_ARGUMENTS"
      ;;
    *)
      [[ -z "$CORPUS" ]] || argument_error "$CORPUS $*"
      CORPUS=$1
      shift
      ;;
  esac
done

case "$THEME" in
  light)
    THEME_FILE="$ROOT/scripts/verify-display-theme.json"
    TERMINAL_BACKGROUND='#faf8f0'
    TERMINAL_FOREGROUND='#282823'
    BACKGROUND_RGB='250,248,240'
    SECONDARY_BACKGROUND_RGB='238,235,224'
    BODY_RGB='40,40,35'
    DETECTOR_IGNORES=(
      50,100,120 80,100,120 70,112,70 150,60,60 140,100,30
      100,100,96 130,130,124 180,178,168 220,216,202 238,235,224
      232,230,220 228,236,224 240,226,222 232,226,236
    )
    ;;
  dark)
    THEME_FILE="$ROOT/scripts/verify-display-theme-dark.json"
    TERMINAL_BACKGROUND='#15181c'
    TERMINAL_FOREGROUND='#e6e1d7'
    BACKGROUND_RGB='21,24,28'
    SECONDARY_BACKGROUND_RGB='36,42,48'
    BODY_RGB='230,225,215'
    DETECTOR_IGNORES=(
      94,168,196 111,137,153 105,184,137 224,108,117 219,174,92
      154,164,174 121,132,143 74,84,94 52,61,70 36,42,48
      38,48,43 50,38,42 39,45,51 43,38,51
    )
    ;;
  *) argument_error "--theme $THEME" ;;
esac

case "$TERMINAL" in
  ghostty) TERMINAL_LABEL=Ghostty ;;
  kitty) TERMINAL_LABEL=Kitty ;;
  *) argument_error "--terminal $TERMINAL" ;;
esac

case "$DISPLAY_PATH" in
  image) DISPLAY_PATH_LABEL=画像経路 ;;
  text) DISPLAY_PATH_LABEL=テキスト経路 ;;
  *) argument_error "--path $DISPLAY_PATH" ;;
esac
if [[ -n "$REFLOW" && ! "$REFLOW" =~ ^[1-9][0-9]*$ ]]; then
  argument_error "--reflow $REFLOW"
fi
REFLOW_WIDTH=
if [[ -n "$REFLOW" ]]; then
  REFLOW_WIDTH=$((REFLOW * 8 + 16))
fi

if [[ "$DESCRIBE" == true ]]; then
  node - "$THEME" "$THEME_FILE" "$TERMINAL" "$EXTENSION" \
    "${REFLOW:-null}" "$DISPLAY_PATH" <<'NODE'
const [theme, themeFile, terminal, extension, reflowValue, path] = process.argv.slice(2);
console.log(JSON.stringify({
  capture: "corpus",
  pixelCheck: "scripts/detect-display-bands.js",
  finalJudgment: "human",
  stages: ["verify-response", "capture", "pixel-check"],
  protocolChecks: [
    "npm run verify:encoder-protocol",
    "npm run verify:pi-protocol",
    "npm run verify:streaming-protocol",
  ],
  theme,
  themeFile,
  terminal,
  extension,
  reflow: reflowValue === "null" ? null : Number(reflowValue),
  path,
}));
NODE
  exit 0
fi

TEMP_DIR=
CAGE_PID=

run() {
  "$ROOT/scripts/run-display-command" infrastructure "$1" \
    timeout --signal=TERM "$COMMAND_TIMEOUT" "$@"
}

# 検証セッションの中だけで動くコマンド。利用者の画面へは触れない。
run_inside() {
  WAYLAND_DISPLAY="$VERIFY_WAYLAND_DISPLAY" \
    "$ROOT/scripts/run-display-command" infrastructure "$1" \
    timeout --signal=TERM "$COMMAND_TIMEOUT" "$@"
}

cleanup() {
  local status=$?
  trap - EXIT INT TERM HUP ERR
  if [[ -n "$CAGE_PID" ]]; then
    kill -- "-$CAGE_PID" 2>/dev/null || kill "$CAGE_PID" 2>/dev/null || true
    wait "$CAGE_PID" 2>/dev/null || true
  fi
  if [[ -n "$TEMP_DIR" ]]; then
    run rm -rf -- "$TEMP_DIR" >/dev/null 2>&1 || true
  fi
  exit "$status"
}

unexpected_error() {
  local status=$?
  local command=$BASH_COMMAND
  trap - ERR
  if [[ "$status" -ne 2 ]]; then
    printf 'verify-display: 実行基盤コマンドが終了コード %s で失敗しました: %s\n' \
      "$status" "$command" >&2
  fi
  exit 2
}

trap cleanup EXIT INT TERM HUP
trap unexpected_error ERR

fail() {
  printf 'verify-display: %s\n' "$*" >&2
  exit 2
}

[[ -n "$CORPUS" ]] || fail "$USAGE"
[[ -f "$CORPUS" ]] || fail "コーパスが見つかりません: $CORPUS"
for command in timeout cage wlr-randr "$TERMINAL" grim pi jq node npm mktemp realpath rm sleep install setsid mkdir; do
  command -v "$command" >/dev/null 2>&1 || fail "必要なコマンドがありません: $command"
done

CORPUS=$(run realpath -- "$CORPUS")
TEMP_DIR=$(run mktemp -d -t pi-formula-verify.XXXXXXXX)
SESSION_FILE="$TEMP_DIR/session.jsonl"
CAPTURE_FILE="$TEMP_DIR/full-history.png"
PREVIOUS_CAPTURE_FILE="$TEMP_DIR/previous-capture.png"
RUNNER="$TEMP_DIR/run-pi"
LAUNCHER="$TEMP_DIR/launch-session"
TERMINAL_CONFIG="$TEMP_DIR/terminal.conf"
CONFIG_HOME="$TEMP_DIR/config"
IMAGE_MARKER="$TEMP_DIR/image-path"
DISPLAY_FILE="$TEMP_DIR/wayland-display"
OUTPUT_FILE="$TEMP_DIR/wayland-output"
CAGE_LOG="$TEMP_DIR/cage.log"
run mkdir -p "$CONFIG_HOME"
if [[ "$DISPLAY_PATH" == text ]]; then
  run mkdir -p "$CONFIG_HOME/pi-formula"
  printf '{"path":"text"}\n' >"$CONFIG_HOME/pi-formula/config.json"
fi
"$ROOT/scripts/run-display-command" infrastructure npm \
  timeout --signal=TERM "$BUILD_TIMEOUT" npm run build
if ! PLAN=$(run node "$ROOT/scripts/verify-display-plan.js" "$CORPUS"); then
  exit 2
fi
HEIGHT=$(printf '%s' "$PLAN" | run jq -r '.height')

if [[ "$TERMINAL" == ghostty ]]; then
  run cat >"$TERMINAL_CONFIG" <<CONFIG
font-size = 12
window-decoration = false
window-padding-x = 8
window-padding-y = 8
background = $TERMINAL_BACKGROUND
foreground = $TERMINAL_FOREGROUND
background-opacity = 1
scrollbar = never
CONFIG
else
  run cat >"$TERMINAL_CONFIG" <<CONFIG
font_size 12
hide_window_decorations yes
window_padding_width 8
background $TERMINAL_BACKGROUND
foreground $TERMINAL_FOREGROUND
background_opacity 1
scrollback_lines 10000
enable_audio_bell no
confirm_os_window_close 0
CONFIG
fi

printf '#!/usr/bin/env bash\nset -Eeuo pipefail\nPI_FORMULA_VERIFY_TITLE=%q\nPI_FORMULA_VERIFY_HEIGHT=%q\nPI_FORMULA_VERIFY_SESSION=%q\nPI_FORMULA_VERIFY_CORPUS=%q\nPI_FORMULA_VERIFY_WINDOW_LIFETIME=%q\nPI_FORMULA_VERIFY_MODEL=%q\nPI_FORMULA_VERIFY_EXTENSION=%q\nPI_FORMULA_VERIFY_MACROS_EXTENSION=%q\nPI_FORMULA_VERIFY_PATH_EXTENSION=%q\nPI_FORMULA_VERIFY_THEME=%q\nPI_FORMULA_VERIFY_CONFIG_HOME=%q\nPI_FORMULA_VERIFY_IMAGE_MARKER=%q\n' \
  "$WINDOW_TITLE" "$HEIGHT" "$SESSION_FILE" "$CORPUS" "$WINDOW_LIFETIME" \
  "${PI_FORMULA_VERIFY_MODEL:-}" "$EXTENSION" \
  "$ROOT/scripts/verify-extensions/pi-formula-verify-macros.ts" \
  "$ROOT/scripts/verify-extensions/pi-formula-verify-image-path.ts" \
  "$THEME_FILE" "$CONFIG_HOME" "$IMAGE_MARKER" >"$RUNNER"
run cat >>"$RUNNER" <<'RUNNER'
export XDG_CONFIG_HOME="$PI_FORMULA_VERIFY_CONFIG_HOME"
export PI_FORMULA_MACROS='{}'
export PI_FORMULA_VERIFY_HEIGHT
export PI_FORMULA_VERIFY_IMAGE_MARKER
unset TMUX STY
args=(
  --name "$PI_FORMULA_VERIFY_TITLE"
  --session "$PI_FORMULA_VERIFY_SESSION"
  --no-extensions
  --extension "$PI_FORMULA_VERIFY_EXTENSION"
  --extension "$PI_FORMULA_VERIFY_MACROS_EXTENSION"
  --extension "$PI_FORMULA_VERIFY_PATH_EXTENSION"
  --no-themes
  --theme "$PI_FORMULA_VERIFY_THEME"
  --use-theme pi-formula-verify
  --no-skills
  --no-prompt-templates
  --no-context-files
  --no-tools
  --approve
  --thinking off
  --system-prompt '添付された Markdown だけを、一字一句そのまま出力してください。説明、前置き、コードフェンスを追加しないでください。'
)
if [[ -n "${PI_FORMULA_VERIFY_MODEL:-}" ]]; then
  args+=(--model "$PI_FORMULA_VERIFY_MODEL")
fi
exec timeout --signal=TERM "$PI_FORMULA_VERIFY_WINDOW_LIFETIME" \
  pi "${args[@]}" "@$PI_FORMULA_VERIFY_CORPUS" \
  '次の Markdown を一字一句そのまま出力してください。'
RUNNER
run chmod +x "$RUNNER"

# 検証セッションの中で走る。出力を計画高へ広げ、その WAYLAND_DISPLAY を外へ伝える。
printf '#!/usr/bin/env bash\nset -Eeuo pipefail\nPI_FORMULA_VERIFY_HEIGHT=%q\nPI_FORMULA_VERIFY_DISPLAY_FILE=%q\nPI_FORMULA_VERIFY_OUTPUT_FILE=%q\nPI_FORMULA_VERIFY_TERMINAL=%q\nPI_FORMULA_VERIFY_TERMINAL_CONFIG=%q\nPI_FORMULA_VERIFY_TITLE=%q\nPI_FORMULA_VERIFY_RUNNER=%q\nPI_FORMULA_VERIFY_WINDOW_LIFETIME=%q\n' \
  "$HEIGHT" "$DISPLAY_FILE" "$OUTPUT_FILE" "$TERMINAL" "$TERMINAL_CONFIG" \
  "$WINDOW_TITLE" "$RUNNER" "$WINDOW_LIFETIME" >"$LAUNCHER"
run cat >>"$LAUNCHER" <<'LAUNCHER'
output=$(wlr-randr | grep -oE '^[A-Za-z0-9-]+' | head -1)
[[ -n "$output" ]] || {
  printf 'verify-display: 検証セッションの出力名を解決できませんでした\n' >&2
  exit 2
}
wlr-randr --output "$output" --custom-mode "1920x${PI_FORMULA_VERIFY_HEIGHT}" || {
  printf 'verify-display: 検証セッションの出力を広げられませんでした\n' >&2
  exit 2
}
printf '%s\n' "$WAYLAND_DISPLAY" >"$PI_FORMULA_VERIFY_DISPLAY_FILE"
printf '%s\n' "$output" >"$PI_FORMULA_VERIFY_OUTPUT_FILE"
case "$PI_FORMULA_VERIFY_TERMINAL" in
  ghostty)
    exec timeout --signal=TERM "$PI_FORMULA_VERIFY_WINDOW_LIFETIME" \
      ghostty --config-default-files=false --gtk-single-instance=false \
      --title="$PI_FORMULA_VERIFY_TITLE" \
      --config-file="$PI_FORMULA_VERIFY_TERMINAL_CONFIG" \
      -e "$PI_FORMULA_VERIFY_RUNNER"
    ;;
  kitty)
    exec timeout --signal=TERM "$PI_FORMULA_VERIFY_WINDOW_LIFETIME" \
      kitty --config "$PI_FORMULA_VERIFY_TERMINAL_CONFIG" \
      --title "$PI_FORMULA_VERIFY_TITLE" \
      "$PI_FORMULA_VERIFY_RUNNER"
    ;;
esac
LAUNCHER
run chmod +x "$LAUNCHER"

# 利用者の画面から独立した検証セッション。画面ロックにも現在の作業にも影響されない。
env -u WAYLAND_DISPLAY -u DISPLAY \
  WLR_BACKENDS=headless WLR_LIBINPUT_NO_DEVICES=1 \
  setsid cage -d -- "$LAUNCHER" >"$CAGE_LOG" 2>&1 &
CAGE_PID=$!

VERIFY_WAYLAND_DISPLAY=
VERIFY_OUTPUT=
for _ in {1..40}; do
  if [[ -s "$DISPLAY_FILE" && -s "$OUTPUT_FILE" ]]; then
    read -r VERIFY_WAYLAND_DISPLAY <"$DISPLAY_FILE"
    read -r VERIFY_OUTPUT <"$OUTPUT_FILE"
    break
  fi
  kill -0 "$CAGE_PID" 2>/dev/null \
    || fail "検証セッションが起動しませんでした: $(tail -3 "$CAGE_LOG" | tr '\n' ' ')"
  run sleep 0.25
done
[[ -n "$VERIFY_WAYLAND_DISPLAY" ]] \
  || fail "検証セッションの WAYLAND_DISPLAY を受け取れませんでした"
[[ -n "$VERIFY_OUTPUT" ]] \
  || fail "検証セッションの出力名を受け取れませんでした"

capture_size=
for ((elapsed = 0; elapsed < SESSION_READY_TIMEOUT; elapsed += 1)); do
  if run_inside grim "$CAPTURE_FILE" >/dev/null 2>&1 && capture_size=$(run node \
    "$ROOT/scripts/verify-display-dimensions.js" size "$CAPTURE_FILE" 2>/dev/null); then
    [[ "$capture_size" == "1920x$HEIGHT" ]] && break
  fi
  capture_size=
  run sleep 1
done
[[ "$capture_size" == "1920x$HEIGHT" ]] \
  || fail "検証セッションの出力を 1920x${HEIGHT} で用意できませんでした"

"$ROOT/scripts/run-display-command" infrastructure wait-for-display-path \
  timeout --signal=TERM "$((IMAGE_PATH_TIMEOUT + COMMAND_TIMEOUT))" \
  node "$ROOT/scripts/wait-for-image-path.js" "$IMAGE_MARKER" \
  "$((IMAGE_PATH_TIMEOUT * 1000))" "$IMAGE_PATH_INTERVAL_MS" "$DISPLAY_PATH" \
  || fail "現在の pi-formula が${DISPLAY_PATH_LABEL}を選べませんでした"

completed=false
for ((attempt = 0; attempt < SESSION_TIMEOUT; attempt += 1)); do
  if "$ROOT/scripts/run-display-command" poll check-display-session \
    timeout --signal=TERM "$COMMAND_TIMEOUT" node \
    "$ROOT/scripts/check-display-session.js" "$SESSION_FILE"; then
    completed=true
    break
  else
    poll_status=$?
    [[ "$poll_status" -eq 1 ]] || fail "Pi のセッション記録を検査できませんでした"
  fi
  run sleep 1
done
[[ "$completed" == true ]] || fail "Pi の応答が ${SESSION_TIMEOUT} 秒以内に完了しませんでした"
run node "$ROOT/scripts/verify-echo.js" "$CORPUS" "$SESSION_FILE" \
  || fail "Pi の応答がコーパスと一字一句一致しません"

wait_for_rendered_capture() {
  local expected_width=$1
  local display_rendered=false
  local capture_deadline=$((SECONDS + CAPTURE_READY_TIMEOUT))
  local poll_status
  local -a rendered_options=(
    "--background=$BACKGROUND_RGB" "--background=$SECONDARY_BACKGROUND_RGB"
  )
  run rm -f -- "$PREVIOUS_CAPTURE_FILE"
  while ((SECONDS < capture_deadline)); do
    run_inside grim "$CAPTURE_FILE"
    run node "$ROOT/scripts/verify-display-dimensions.js" png \
      "$CAPTURE_FILE" "$expected_width" "$HEIGHT" \
      || fail "検証セッションのキャプチャ寸法が不正です"
    if "$ROOT/scripts/run-display-command" poll check-display-rendered \
      timeout --signal=TERM "$COMMAND_TIMEOUT" node \
      "$ROOT/scripts/check-display-rendered.js" \
      "${rendered_options[@]}" "$CAPTURE_FILE"; then
      display_rendered=true
      break
    else
      poll_status=$?
      [[ "$poll_status" -eq 1 ]] \
        || fail "キャプチャの描画完了を検査できませんでした"
    fi
    run install -m 0644 "$CAPTURE_FILE" "$PREVIOUS_CAPTURE_FILE"
    rendered_options=("--background=$BACKGROUND_RGB" \
      "--background=$SECONDARY_BACKGROUND_RGB" \
      "--previous=$PREVIOUS_CAPTURE_FILE")
    run sleep "$CAPTURE_READY_INTERVAL"
  done
  [[ "$display_rendered" == true ]] \
    || fail "$TERMINAL_LABEL の描画完了をキャプチャで確認できませんでした"
}

wait_for_rendered_capture 1920
if [[ -n "$REFLOW" ]]; then
  run_inside wlr-randr --output "$VERIFY_OUTPUT" \
    --custom-mode "${REFLOW_WIDTH}x${HEIGHT}" \
    || fail "検証セッションの出力を ${REFLOW} 列相当へ変更できませんでした"
  wait_for_rendered_capture "$REFLOW_WIDTH"
fi

# 表示の正しさは人が目で確かめる。撮れた画面を必ず残して場所を伝える。
CAPTURE_DESTINATION=${PI_FORMULA_VERIFY_CAPTURE:-${XDG_STATE_HOME:-$HOME/.local/state}/pi-formula/verify-display-capture.png}
run mkdir -p -- "${CAPTURE_DESTINATION%/*}"
run install -m 0644 "$CAPTURE_FILE" "$CAPTURE_DESTINATION"
printf 'キャプチャ: %s\n' "$CAPTURE_DESTINATION"

trap - ERR
detector_status=0
detector_args=("--background=$BACKGROUND_RGB" "--body=$BODY_RGB")
for color in "${DETECTOR_IGNORES[@]}"; do
  detector_args+=("--ignore=$color")
done
"$ROOT/scripts/run-display-command" detector detect-display-bands \
  timeout --signal=TERM "$DETECTOR_TIMEOUT" node "$ROOT/scripts/detect-display-bands.js" \
  "${detector_args[@]}" "$CAPTURE_FILE" || detector_status=$?
[[ "$detector_status" -le 1 ]] || fail "キャプチャをピクセル判定できませんでした"
if [[ "$detector_status" -eq 1 ]]; then
  printf 'キャプチャを開いて表示を確認してください: %s\n' "$CAPTURE_DESTINATION" >&2
fi
exit "$detector_status"
