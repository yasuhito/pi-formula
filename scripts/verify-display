#!/usr/bin/env bash
set -Eeuo pipefail

COMMAND_TIMEOUT=8
BUILD_TIMEOUT=120
DETECTOR_TIMEOUT=30
SESSION_TIMEOUT=150
CAPTURE_READY_TIMEOUT=30
CAPTURE_READY_INTERVAL=2
BASELINE_READY_TIMEOUT=30
BASELINE_CAPTURE_TIMEOUT=30
STREAM_CAPTURE_TIMEOUT=30
FINAL_FORMULA_TIMEOUT=60
IMAGE_PATH_TIMEOUT=15
WINDOW_LIFETIME=240
EXPLORATION_WINDOW_LIFETIME=600
SESSION_READY_TIMEOUT=30
WINDOW_TITLE="pi-formula-verify-$$"
SCRIPT_DIR=${BASH_SOURCE[0]%/*}
[[ "$SCRIPT_DIR" != "${BASH_SOURCE[0]}" ]] || SCRIPT_DIR=.
ROOT=$(cd -- "$SCRIPT_DIR/.." && pwd)
MODE=corpus
CORPUS=
PROMPT=
RESPONSE_DESTINATION=
SAVE_RESPONSE=false
EXTRA_EXTENSIONS=()
TOOLS=
TOOLS_SET=false
ARGUMENT_ERROR=
if [[ "${1:-}" == --prompt ]]; then
  MODE=exploration
  PROMPT=${2:-}
  shift 2 || true
  while [[ $# -gt 0 && -z "$ARGUMENT_ERROR" ]]; do
    case "$1" in
      --save-response)
        if [[ "$SAVE_RESPONSE" == true || $# -lt 2 ]]; then
          ARGUMENT_ERROR="--save-response には保存先が1つ必要です"
        else
          SAVE_RESPONSE=true
          RESPONSE_DESTINATION=$2
          shift 2
        fi
        ;;
      --extension)
        if [[ $# -lt 2 ]]; then
          ARGUMENT_ERROR="--extension には拡張のパスが必要です"
        else
          EXTRA_EXTENSIONS+=("$2")
          shift 2
        fi
        ;;
      --tools)
        if [[ "$TOOLS_SET" == true || $# -lt 2 ]]; then
          ARGUMENT_ERROR="--tools にはツール名の一覧が1つ必要です"
        else
          TOOLS_SET=true
          TOOLS=$2
          shift 2
        fi
        ;;
      *) ARGUMENT_ERROR="未対応の引数です: $1" ;;
    esac
  done
else
  CORPUS=${1:-}
  shift || true
  [[ $# -eq 0 ]] || ARGUMENT_ERROR="未対応の引数です: $*"
fi
if [[ "$MODE" == exploration ]]; then
  WINDOW_LIFETIME=$EXPLORATION_WINDOW_LIFETIME
fi
TEMP_DIR=
CAGE_PID=

run() {
  "$ROOT/scripts/run-display-command" infrastructure "$1" \
    timeout --signal=TERM "$COMMAND_TIMEOUT" "$@"
}

# 検証セッションの中だけで動くコマンド。利用者の画面へは触れない。
run_inside() {
  WAYLAND_DISPLAY="$VERIFY_WAYLAND_DISPLAY" \
    "$ROOT/scripts/run-display-command" infrastructure "$1" \
    timeout --signal=TERM "$COMMAND_TIMEOUT" "$@"
}

cleanup() {
  local status=$?
  trap - EXIT INT TERM HUP ERR
  if [[ -n "$CAGE_PID" ]]; then
    kill -- "-$CAGE_PID" 2>/dev/null || kill "$CAGE_PID" 2>/dev/null || true
    kill -CONT -- "-$CAGE_PID" 2>/dev/null || true
    wait "$CAGE_PID" 2>/dev/null || true
  fi
  if [[ -n "$TEMP_DIR" ]]; then
    run rm -rf -- "$TEMP_DIR" >/dev/null 2>&1 || true
  fi
  exit "$status"
}

unexpected_error() {
  local status=$?
  local command=$BASH_COMMAND
  trap - ERR
  if [[ "$status" -ne 2 ]]; then
    printf 'verify-display: 実行基盤コマンドが終了コード %s で失敗しました: %s\n' \
      "$status" "$command" >&2
  fi
  exit 2
}

trap cleanup EXIT INT TERM HUP
trap unexpected_error ERR

fail() {
  printf 'verify-display: %s\n' "$*" >&2
  exit 2
}

fail_with_usage() {
  printf 'verify-display: %s\n%s\n' "$1" "$USAGE" >&2
  exit 2
}

USAGE="Usage: scripts/verify-display <corpus.md> | --prompt <prompt> [--save-response <corpus.md>] [--extension <path>]... [--tools <names>]"
[[ -z "$ARGUMENT_ERROR" ]] || fail_with_usage "$ARGUMENT_ERROR"
if [[ "$MODE" == corpus ]]; then
  [[ -n "$CORPUS" ]] || fail "$USAGE"
  [[ -f "$CORPUS" ]] || fail "コーパスが見つかりません: $CORPUS"
else
  [[ -n "$PROMPT" ]] || fail "$USAGE"
  [[ "$SAVE_RESPONSE" == false || -n "$RESPONSE_DESTINATION" ]] || fail "$USAGE"
  [[ "$TOOLS_SET" == false || -n "$TOOLS" ]] || fail "$USAGE"
  for extension in "${EXTRA_EXTENSIONS[@]}"; do
    case "$extension" in
      */qni-math/index.js | */qni-math/index.ts)
        fail "qni-math の描画 entry point は pi-formula と同時に読み込めません"
        ;;
    esac
  done
fi
PROMPT_INPUT="pi-formula-verify-prompt:$PROMPT"
for command in timeout cage wlr-randr ghostty grim pi jq node npm mktemp realpath rm sleep install setsid ps mkdir touch; do
  command -v "$command" >/dev/null 2>&1 || fail "必要なコマンドがありません: $command"
done

if [[ "$MODE" == corpus ]]; then
  CORPUS=$(run realpath -- "$CORPUS")
fi
TEMP_DIR=$(run mktemp -d -t pi-formula-verify.XXXXXXXX)
SESSION_FILE="$TEMP_DIR/session.jsonl"
CAPTURE_FILE="$TEMP_DIR/full-history.png"
PREVIOUS_CAPTURE_FILE="$TEMP_DIR/previous-capture.png"
RUNNER="$TEMP_DIR/run-pi"
LAUNCHER="$TEMP_DIR/launch-session"
GHOSTTY_CONFIG="$TEMP_DIR/ghostty.conf"
CONFIG_HOME="$TEMP_DIR/config"
IMAGE_MARKER="$TEMP_DIR/image-path"
BASELINE_MARKER="$TEMP_DIR/baseline-ready"
BASELINE_CAPTURE_ACK="$TEMP_DIR/baseline-captured"
BASELINE_CAPTURE_FILE="$TEMP_DIR/baseline.png"
BASELINE_PREVIOUS_CAPTURE_FILE="$TEMP_DIR/previous-baseline.png"
STREAM_MARKER="$TEMP_DIR/assistant-streaming"
STREAM_RENDERED_MARKER="$TEMP_DIR/assistant-streaming-rendered"
STREAM_PROCESS_MARKER="$TEMP_DIR/assistant-process"
STREAM_CAPTURE_ACK="$TEMP_DIR/assistant-streaming-captured"
STREAM_CAPTURE_FILE="$TEMP_DIR/streaming.png"
STREAM_PREVIOUS_CAPTURE_FILE="$TEMP_DIR/previous-streaming.png"
FINAL_FORMULA_MARKER="$TEMP_DIR/final-formula-path"
FINAL_CAPTURE_MARKER="$TEMP_DIR/final-capture-ready"
FINAL_CAPTURE_ACK="$TEMP_DIR/final-captured"
DISPLAY_FILE="$TEMP_DIR/wayland-display"
CAGE_LOG="$TEMP_DIR/cage.log"
run mkdir -p "$CONFIG_HOME"
"$ROOT/scripts/run-display-command" infrastructure npm \
  timeout --signal=TERM "$BUILD_TIMEOUT" npm run build
if [[ "$MODE" == corpus ]]; then
  PLAN_ERROR="$TEMP_DIR/display-plan-error"
  if ! PLAN=$(run node "$ROOT/scripts/plan-display.js" "$CORPUS" 2>"$PLAN_ERROR"); then
    cat -- "$PLAN_ERROR" >&2
    exit 2
  fi
  HEIGHT=$(printf '%s' "$PLAN" | run jq -r '.height')
  IMAGE_ROWS=$(printf '%s' "$PLAN" | run jq -r '.imageRows')
  FAILED_FORMULAS=$(printf '%s' "$PLAN" | run jq -r '.failedFormulas')
  [[ "$HEIGHT" =~ ^[0-9]+$ && "$HEIGHT" -le 16000 ]] \
    || fail "表示計画の出力高が不正です"
  [[ "$IMAGE_ROWS" =~ ^[1-9][0-9]*$ ]] \
    || fail "コーパスに表示数式の画像行がありません"
  [[ "$FAILED_FORMULAS" =~ ^[0-9]+$ ]] \
    || fail "表示計画の組版失敗数が不正です"
  printf 'verify-display: 組版に失敗した表示数式: %s\n' "$FAILED_FORMULAS"
else
  # 応答は事前に分からないため、探索モードは検証上限の全履歴を用意する。
  HEIGHT=16000
fi

run cat >"$GHOSTTY_CONFIG" <<'CONFIG'
font-size = 12
window-decoration = false
window-padding-x = 8
window-padding-y = 8
background = #faf8f0
foreground = #282823
background-opacity = 1
scrollbar = never
CONFIG

printf '#!/usr/bin/env bash\nset -Eeuo pipefail\nPI_FORMULA_VERIFY_TITLE=%q\nPI_FORMULA_VERIFY_HEIGHT=%q\nPI_FORMULA_VERIFY_SESSION=%q\nPI_FORMULA_VERIFY_MODE=%q\nPI_FORMULA_VERIFY_CORPUS=%q\nPI_FORMULA_VERIFY_PROMPT_INPUT=%q\nPI_FORMULA_VERIFY_TOOLS=%q\nPI_FORMULA_VERIFY_WINDOW_LIFETIME=%q\nPI_FORMULA_VERIFY_MODEL=%q\nPI_FORMULA_VERIFY_TARGET_EXTENSION=%q\nPI_FORMULA_VERIFY_EXTENSION=%q\nPI_FORMULA_VERIFY_MACROS_EXTENSION=%q\nPI_FORMULA_VERIFY_PATH_EXTENSION=%q\nPI_FORMULA_VERIFY_PROMPT_EXTENSION=%q\nPI_FORMULA_VERIFY_THEME=%q\nPI_FORMULA_VERIFY_CONFIG_HOME=%q\nPI_FORMULA_VERIFY_IMAGE_MARKER=%q\nPI_FORMULA_VERIFY_BASELINE_MARKER=%q\nPI_FORMULA_VERIFY_BASELINE_ACK=%q\nPI_FORMULA_VERIFY_STREAM_MARKER=%q\nPI_FORMULA_VERIFY_STREAM_RENDERED_MARKER=%q\nPI_FORMULA_VERIFY_STREAM_PROCESS_MARKER=%q\nPI_FORMULA_VERIFY_STREAM_ACK=%q\nPI_FORMULA_VERIFY_FINAL_FORMULA_MARKER=%q\nPI_FORMULA_VERIFY_FINAL_CAPTURE_MARKER=%q\nPI_FORMULA_VERIFY_FINAL_CAPTURE_ACK=%q\nPI_FORMULA_VERIFY_EXTRA_EXTENSIONS=()\n' \
  "$WINDOW_TITLE" "$HEIGHT" "$SESSION_FILE" "$MODE" "$CORPUS" "$PROMPT_INPUT" "$TOOLS" \
  "$WINDOW_LIFETIME" "${PI_FORMULA_VERIFY_MODEL:-}" \
  "$ROOT/scripts/verify-extensions/pi-formula-verify-target.ts" "$ROOT/src/extension.ts" \
  "$ROOT/scripts/verify-extensions/pi-formula-verify-macros.ts" \
  "$ROOT/scripts/verify-extensions/pi-formula-verify-image-path.ts" \
  "$ROOT/scripts/verify-extensions/pi-formula-verify-prompt.ts" \
  "$ROOT/scripts/verify-display-theme.json" "$CONFIG_HOME" "$IMAGE_MARKER" \
  "$BASELINE_MARKER" "$BASELINE_CAPTURE_ACK" "$STREAM_MARKER" \
  "$STREAM_RENDERED_MARKER" "$STREAM_PROCESS_MARKER" "$STREAM_CAPTURE_ACK" \
  "$FINAL_FORMULA_MARKER" "$FINAL_CAPTURE_MARKER" "$FINAL_CAPTURE_ACK" >"$RUNNER"
for extension in "${EXTRA_EXTENSIONS[@]}"; do
  printf 'PI_FORMULA_VERIFY_EXTRA_EXTENSIONS+=(%q)\n' "$extension" >>"$RUNNER"
done
run cat >>"$RUNNER" <<'RUNNER'
export XDG_CONFIG_HOME="$PI_FORMULA_VERIFY_CONFIG_HOME"
export PI_FORMULA_MACROS='{}'
export PI_FORMULA_VERIFY_HEIGHT
export PI_FORMULA_VERIFY_MODE
export PI_FORMULA_VERIFY_IMAGE_MARKER
export PI_FORMULA_VERIFY_BASELINE_MARKER
export PI_FORMULA_VERIFY_BASELINE_ACK
export PI_FORMULA_VERIFY_STREAM_MARKER
export PI_FORMULA_VERIFY_STREAM_RENDERED_MARKER
export PI_FORMULA_VERIFY_STREAM_PROCESS_MARKER
export PI_FORMULA_VERIFY_STREAM_ACK
export PI_FORMULA_VERIFY_FINAL_FORMULA_MARKER
export PI_FORMULA_VERIFY_FINAL_CAPTURE_MARKER
export PI_FORMULA_VERIFY_FINAL_CAPTURE_ACK
unset TMUX STY
args=(
  --name "$PI_FORMULA_VERIFY_TITLE"
  --session "$PI_FORMULA_VERIFY_SESSION"
  --no-extensions
  --extension "$PI_FORMULA_VERIFY_TARGET_EXTENSION"
  --extension "$PI_FORMULA_VERIFY_EXTENSION"
  --extension "$PI_FORMULA_VERIFY_MACROS_EXTENSION"
  --extension "$PI_FORMULA_VERIFY_PATH_EXTENSION"
  --extension "$PI_FORMULA_VERIFY_PROMPT_EXTENSION"
  --no-themes
  --theme "$PI_FORMULA_VERIFY_THEME"
  --use-theme pi-formula-verify
  --no-skills
  --no-prompt-templates
  --no-context-files
  --approve
  --thinking off
)
if [[ -n "${PI_FORMULA_VERIFY_MODEL:-}" ]]; then
  args+=(--model "$PI_FORMULA_VERIFY_MODEL")
fi
for extension in "${PI_FORMULA_VERIFY_EXTRA_EXTENSIONS[@]}"; do
  args+=(--extension "$extension")
done
if [[ "$PI_FORMULA_VERIFY_MODE" == exploration ]]; then
  if [[ -n "$PI_FORMULA_VERIFY_TOOLS" ]]; then
    args+=(--tools "$PI_FORMULA_VERIFY_TOOLS")
  else
    args+=(--no-tools)
  fi
  exec timeout --signal=TERM "$PI_FORMULA_VERIFY_WINDOW_LIFETIME" \
    pi "${args[@]}" "$PI_FORMULA_VERIFY_PROMPT_INPUT"
fi
args+=(
  --no-tools
  --system-prompt '添付された Markdown だけを、一字一句そのまま出力してください。説明、前置き、コードフェンスを追加しないでください。'
)
exec timeout --signal=TERM "$PI_FORMULA_VERIFY_WINDOW_LIFETIME" \
  pi "${args[@]}" "@$PI_FORMULA_VERIFY_CORPUS" \
  '次の Markdown を一字一句そのまま出力してください。'
RUNNER
run chmod +x "$RUNNER"

# 検証セッションの中で走る。出力を計画高へ広げ、その WAYLAND_DISPLAY を外へ伝える。
printf '#!/usr/bin/env bash\nset -Eeuo pipefail\nPI_FORMULA_VERIFY_HEIGHT=%q\nPI_FORMULA_VERIFY_DISPLAY_FILE=%q\nPI_FORMULA_VERIFY_GHOSTTY_CONFIG=%q\nPI_FORMULA_VERIFY_TITLE=%q\nPI_FORMULA_VERIFY_RUNNER=%q\nPI_FORMULA_VERIFY_WINDOW_LIFETIME=%q\n' \
  "$HEIGHT" "$DISPLAY_FILE" "$GHOSTTY_CONFIG" "$WINDOW_TITLE" "$RUNNER" \
  "$WINDOW_LIFETIME" >"$LAUNCHER"
run cat >>"$LAUNCHER" <<'LAUNCHER'
output=$(wlr-randr | grep -oE '^[A-Za-z0-9-]+' | head -1)
[[ -n "$output" ]] || {
  printf 'verify-display: 検証セッションの出力名を解決できませんでした\n' >&2
  exit 2
}
wlr-randr --output "$output" --custom-mode "1920x${PI_FORMULA_VERIFY_HEIGHT}" || {
  printf 'verify-display: 検証セッションの出力を広げられませんでした\n' >&2
  exit 2
}
printf '%s\n' "$WAYLAND_DISPLAY" >"$PI_FORMULA_VERIFY_DISPLAY_FILE"
exec timeout --signal=TERM "$PI_FORMULA_VERIFY_WINDOW_LIFETIME" \
  ghostty --config-default-files=false --gtk-single-instance=false \
  --title="$PI_FORMULA_VERIFY_TITLE" \
  --config-file="$PI_FORMULA_VERIFY_GHOSTTY_CONFIG" \
  -e "$PI_FORMULA_VERIFY_RUNNER"
LAUNCHER
run chmod +x "$LAUNCHER"

# 利用者の画面から独立した検証セッション。画面ロックにも現在の作業にも影響されない。
env -u WAYLAND_DISPLAY -u DISPLAY \
  WLR_BACKENDS=headless WLR_LIBINPUT_NO_DEVICES=1 \
  setsid cage -d -- "$LAUNCHER" >"$CAGE_LOG" 2>&1 &
CAGE_PID=$!

VERIFY_WAYLAND_DISPLAY=
for _ in {1..40}; do
  if [[ -s "$DISPLAY_FILE" ]]; then
    read -r VERIFY_WAYLAND_DISPLAY <"$DISPLAY_FILE"
    break
  fi
  kill -0 "$CAGE_PID" 2>/dev/null \
    || fail "検証セッションが起動しませんでした: $(tail -3 "$CAGE_LOG" | tr '\n' ' ')"
  run sleep 0.25
done
[[ -n "$VERIFY_WAYLAND_DISPLAY" ]] \
  || fail "検証セッションの WAYLAND_DISPLAY を受け取れませんでした"

capture_size=
for ((elapsed = 0; elapsed < SESSION_READY_TIMEOUT; elapsed += 1)); do
  if run_inside grim "$CAPTURE_FILE" >/dev/null 2>&1 && capture_size=$(run node \
    "$ROOT/scripts/verify-display-dimensions.js" size "$CAPTURE_FILE" 2>/dev/null); then
    [[ "$capture_size" == "1920x$HEIGHT" ]] && break
  fi
  capture_size=
  run sleep 1
done
[[ "$capture_size" == "1920x$HEIGHT" ]] \
  || fail "検証セッションの出力を 1920x${HEIGHT} で用意できませんでした"

if [[ "$MODE" == exploration ]]; then
  baseline_ready=false
  for ((elapsed = 0; elapsed < BASELINE_READY_TIMEOUT; elapsed += 1)); do
    if [[ -s "$BASELINE_MARKER" ]]; then
      baseline_ready=true
      break
    fi
    run sleep 1
  done
  [[ "$baseline_ready" == true ]] \
    || fail "対象式前のキャプチャを開始できませんでした"

  baseline_rendered=false
  baseline_capture_deadline=$((SECONDS + BASELINE_CAPTURE_TIMEOUT))
  baseline_rendered_options=(--allow-blank \
    --background=250,248,240 --background=238,235,224)
  while ((SECONDS < baseline_capture_deadline)); do
    run_inside grim "$BASELINE_CAPTURE_FILE"
    run node "$ROOT/scripts/verify-display-dimensions.js" png \
      "$BASELINE_CAPTURE_FILE" 1920 "$HEIGHT" \
      || fail "対象式前のキャプチャ寸法が不正です"
    if "$ROOT/scripts/run-display-command" poll check-baseline-rendered \
      timeout --signal=TERM "$COMMAND_TIMEOUT" node \
      "$ROOT/scripts/check-display-rendered.js" \
      "${baseline_rendered_options[@]}" "$BASELINE_CAPTURE_FILE"; then
      baseline_rendered=true
      break
    else
      poll_status=$?
      [[ "$poll_status" -eq 1 ]] \
        || fail "対象式前の描画完了を検査できませんでした"
    fi
    run install -m 0644 "$BASELINE_CAPTURE_FILE" "$BASELINE_PREVIOUS_CAPTURE_FILE"
    baseline_rendered_options=(--allow-blank \
      --background=250,248,240 --background=238,235,224 \
      "--previous=$BASELINE_PREVIOUS_CAPTURE_FILE")
    run sleep "$CAPTURE_READY_INTERVAL"
  done
  [[ "$baseline_rendered" == true ]] \
    || fail "対象式前の描画完了をキャプチャで確認できませんでした"
  run touch "$BASELINE_CAPTURE_ACK"
fi

for ((elapsed = 0; elapsed < IMAGE_PATH_TIMEOUT; elapsed += 1)); do
  [[ -s "$IMAGE_MARKER" ]] && break
  run sleep 1
done
run node "$ROOT/scripts/verify-image-path.js" "$IMAGE_MARKER" \
  || fail "現在の pi-formula が画像経路を選べませんでした"

rendered_options=(--background=250,248,240 --background=238,235,224)
stream_detector_status=0
detector_status=0
if [[ "$MODE" == exploration ]]; then
  stream_ready=false
  for ((elapsed = 0; elapsed < STREAM_CAPTURE_TIMEOUT; elapsed += 1)); do
    if [[ -s "$STREAM_MARKER" ]]; then
      stream_ready=true
      break
    fi
    run sleep 1
  done
  [[ "$stream_ready" == true ]] \
    || fail "assistant 応答のストリーミング中フレームを撮影できませんでした"
  read -r stream_process_pid <"$STREAM_PROCESS_MARKER"
  [[ "$stream_process_pid" =~ ^[1-9][0-9]*$ ]] \
    || fail "Pi の process ID を確認できませんでした"
  # transformer の後続描画と compositor 反映に機会を与えてから TUI を止める。
  run sleep "$CAPTURE_READY_INTERVAL"
  run kill -STOP "$stream_process_pid"

  if "$ROOT/scripts/run-display-command" poll check-display-session \
    timeout --signal=TERM "$COMMAND_TIMEOUT" node \
    "$ROOT/scripts/check-display-session.js" "$SESSION_FILE"; then
    fail "ストリーミング中の撮影前に assistant 応答が完了しました"
  else
    poll_status=$?
    [[ "$poll_status" -eq 1 ]] || fail "Pi のセッション記録を検査できませんでした"
  fi

  stream_display_rendered=false
  stream_capture_deadline=$((SECONDS + CAPTURE_READY_TIMEOUT))
  stream_rendered_options=(--background=250,248,240 --background=238,235,224 \
    "--different-from=$BASELINE_CAPTURE_FILE")
  while ((SECONDS < stream_capture_deadline)); do
    run_inside grim "$STREAM_CAPTURE_FILE"
    run node "$ROOT/scripts/verify-display-dimensions.js" png \
      "$STREAM_CAPTURE_FILE" 1920 "$HEIGHT" \
      || fail "ストリーミング中のキャプチャ寸法が不正です"
    if "$ROOT/scripts/run-display-command" poll check-streaming-display-rendered \
      timeout --signal=TERM "$COMMAND_TIMEOUT" node \
      "$ROOT/scripts/check-display-rendered.js" \
      "${stream_rendered_options[@]}" "$STREAM_CAPTURE_FILE"; then
      stream_display_rendered=true
      break
    else
      poll_status=$?
      [[ "$poll_status" -eq 1 ]] \
        || fail "ストリーミング中の描画完了を検査できませんでした"
    fi
    run install -m 0644 "$STREAM_CAPTURE_FILE" "$STREAM_PREVIOUS_CAPTURE_FILE"
    stream_rendered_options=(--background=250,248,240 --background=238,235,224 \
      "--different-from=$BASELINE_CAPTURE_FILE" \
      "--previous=$STREAM_PREVIOUS_CAPTURE_FILE")
    run sleep "$CAPTURE_READY_INTERVAL"
  done
  [[ "$stream_display_rendered" == true ]] \
    || fail "ストリーミング中の描画完了をキャプチャで確認できませんでした"

  "$ROOT/scripts/run-display-command" detector detect-streaming-display-bands \
    timeout --signal=TERM "$DETECTOR_TIMEOUT" node "$ROOT/scripts/detect-display-bands.js" \
    --background=250,248,240 --body=40,40,35 \
    --ignore=50,100,120 --ignore=80,100,120 --ignore=70,112,70 \
    --ignore=150,60,60 --ignore=140,100,30 --ignore=100,100,96 \
    --ignore=130,130,124 --ignore=180,178,168 --ignore=220,216,202 \
    --ignore=238,235,224 --ignore=232,230,220 --ignore=228,236,224 \
    --ignore=240,226,222 --ignore=232,226,236 "$STREAM_CAPTURE_FILE" \
    || stream_detector_status=$?
  [[ "$stream_detector_status" -le 1 ]] \
    || fail "ストリーミング中のピクセル判定を実行できませんでした"

  CAPTURE_DESTINATION=${PI_FORMULA_VERIFY_CAPTURE:-${XDG_STATE_HOME:-$HOME/.local/state}/pi-formula/verify-display-capture.png}
  STREAM_CAPTURE_DESTINATION=${PI_FORMULA_VERIFY_STREAM_CAPTURE:-${CAPTURE_DESTINATION%.png}-streaming.png}
  run mkdir -p -- "${STREAM_CAPTURE_DESTINATION%/*}"
  run install -m 0644 "$STREAM_CAPTURE_FILE" "$STREAM_CAPTURE_DESTINATION"
  printf 'ストリーミング中のキャプチャ: %s\n' "$STREAM_CAPTURE_DESTINATION"
  run kill -CONT "$stream_process_pid"
  run touch "$STREAM_CAPTURE_ACK"
fi

completed=false
if [[ "$MODE" == exploration ]]; then
  final_capture_gated=false
  for ((elapsed = 0; elapsed < FINAL_FORMULA_TIMEOUT; elapsed += 1)); do
    if [[ -s "$FINAL_CAPTURE_MARKER" ]]; then
      final_capture_gated=true
      break
    fi
    if "$ROOT/scripts/run-display-command" poll check-display-session \
      timeout --signal=TERM "$COMMAND_TIMEOUT" node \
      "$ROOT/scripts/check-display-session.js" "$SESSION_FILE"; then
      completed=true
      break
    else
      poll_status=$?
      [[ "$poll_status" -eq 1 ]] || fail "Pi のセッション記録を検査できませんでした"
    fi
    run sleep 1
  done
  [[ "$final_capture_gated" == true || "$completed" == true ]] \
    || fail "対象式の確定画面を後続処理の前に撮影できませんでした"

  for ((elapsed = 0; elapsed < FINAL_FORMULA_TIMEOUT; elapsed += 1)); do
    [[ -s "$FINAL_FORMULA_MARKER" ]] && break
    run sleep 1
  done
  run node "$ROOT/scripts/verify-streamed-formula.js" \
    "$SESSION_FILE" "$STREAM_MARKER" "$FINAL_FORMULA_MARKER" \
    || fail "未完了時と確定後で同じ表示数式の画像経路を確認できませんでした"

  final_process_stopped=false
  if [[ "$final_capture_gated" == true ]]; then
    run sleep "$CAPTURE_READY_INTERVAL"
    run kill -STOP "$stream_process_pid"
    final_process_stopped=true
  fi

  display_rendered=false
  capture_deadline=$((SECONDS + CAPTURE_READY_TIMEOUT))
  rendered_options=(--background=250,248,240 --background=238,235,224 \
    "--different-from=$STREAM_CAPTURE_FILE")
  while ((SECONDS < capture_deadline)); do
    run_inside grim "$CAPTURE_FILE"
    run node "$ROOT/scripts/verify-display-dimensions.js" png "$CAPTURE_FILE" 1920 "$HEIGHT" \
      || fail "対象式の確定キャプチャ寸法が不正です"
    if "$ROOT/scripts/run-display-command" poll check-final-display-rendered \
      timeout --signal=TERM "$COMMAND_TIMEOUT" node \
      "$ROOT/scripts/check-display-rendered.js" \
      "${rendered_options[@]}" "$CAPTURE_FILE"; then
      display_rendered=true
      break
    else
      poll_status=$?
      [[ "$poll_status" -eq 1 ]] || fail "対象式の確定描画を検査できませんでした"
    fi
    run install -m 0644 "$CAPTURE_FILE" "$PREVIOUS_CAPTURE_FILE"
    rendered_options=(--background=250,248,240 --background=238,235,224 \
      "--different-from=$STREAM_CAPTURE_FILE" \
      "--previous=$PREVIOUS_CAPTURE_FILE")
    run sleep "$CAPTURE_READY_INTERVAL"
  done
  [[ "$display_rendered" == true ]] \
    || fail "対象式の確定描画をキャプチャで確認できませんでした"

  CAPTURE_DESTINATION=${PI_FORMULA_VERIFY_CAPTURE:-${XDG_STATE_HOME:-$HOME/.local/state}/pi-formula/verify-display-capture.png}
  run mkdir -p -- "${CAPTURE_DESTINATION%/*}"
  run install -m 0644 "$CAPTURE_FILE" "$CAPTURE_DESTINATION"
  printf 'キャプチャ: %s\n' "$CAPTURE_DESTINATION"

  "$ROOT/scripts/run-display-command" detector detect-display-bands \
    timeout --signal=TERM "$DETECTOR_TIMEOUT" node "$ROOT/scripts/detect-display-bands.js" \
    --background=250,248,240 --body=40,40,35 \
    --ignore=50,100,120 --ignore=80,100,120 --ignore=70,112,70 \
    --ignore=150,60,60 --ignore=140,100,30 --ignore=100,100,96 \
    --ignore=130,130,124 --ignore=180,178,168 --ignore=220,216,202 \
    --ignore=238,235,224 --ignore=232,230,220 --ignore=228,236,224 \
    --ignore=240,226,222 --ignore=232,226,236 "$CAPTURE_FILE" || detector_status=$?
  [[ "$detector_status" -le 1 ]] \
    || fail "対象式の確定画面をピクセル判定できませんでした"

  if [[ "$final_process_stopped" == true ]]; then
    run kill -CONT "$stream_process_pid"
    run touch "$FINAL_CAPTURE_ACK"
  fi
fi

for ((attempt = 0; attempt < SESSION_TIMEOUT; attempt += 1)); do
  [[ "$completed" == true ]] && break
  if "$ROOT/scripts/run-display-command" poll check-display-session \
    timeout --signal=TERM "$COMMAND_TIMEOUT" node \
    "$ROOT/scripts/check-display-session.js" "$SESSION_FILE"; then
    completed=true
    break
  else
    poll_status=$?
    [[ "$poll_status" -eq 1 ]] || fail "Pi のセッション記録を検査できませんでした"
  fi
  run sleep 1
done
[[ "$completed" == true ]] || fail "Pi の応答が ${SESSION_TIMEOUT} 秒以内に完了しませんでした"
if [[ "$MODE" == corpus ]]; then
  run node "$ROOT/scripts/verify-echo.js" "$CORPUS" "$SESSION_FILE" \
    || fail "Pi の応答がコーパスと一字一句一致しません"
elif [[ -n "$RESPONSE_DESTINATION" ]]; then
  run node "$ROOT/scripts/save-display-response.js" \
    "$SESSION_FILE" "$RESPONSE_DESTINATION" "$STREAM_MARKER" \
    || fail "探索で得た応答をコーパスへ保存できませんでした"
  printf 'コーパス: %s\n' "$RESPONSE_DESTINATION"
fi

if [[ "$MODE" == corpus ]]; then
  display_rendered=false
  capture_deadline=$((SECONDS + CAPTURE_READY_TIMEOUT))
while ((SECONDS < capture_deadline)); do
  run_inside grim "$CAPTURE_FILE"
  run node "$ROOT/scripts/verify-display-dimensions.js" png "$CAPTURE_FILE" 1920 "$HEIGHT" \
    || fail "検証セッションのキャプチャ寸法が不正です"
  if "$ROOT/scripts/run-display-command" poll check-display-rendered \
    timeout --signal=TERM "$COMMAND_TIMEOUT" node "$ROOT/scripts/check-display-rendered.js" \
    "${rendered_options[@]}" "$CAPTURE_FILE"; then
    display_rendered=true
    break
  else
    poll_status=$?
    [[ "$poll_status" -eq 1 ]] || fail "キャプチャの描画完了を検査できませんでした"
  fi
  run install -m 0644 "$CAPTURE_FILE" "$PREVIOUS_CAPTURE_FILE"
  rendered_options=(--background=250,248,240 --background=238,235,224 \
    "--previous=$PREVIOUS_CAPTURE_FILE")
  run sleep "$CAPTURE_READY_INTERVAL"
done
[[ "$display_rendered" == true ]] \
  || fail "Ghostty の描画完了をキャプチャで確認できませんでした"
# 表示の正しさは人と Agent が目で確かめる。撮れた画面を必ず残して場所を伝える。
CAPTURE_DESTINATION=${PI_FORMULA_VERIFY_CAPTURE:-${XDG_STATE_HOME:-$HOME/.local/state}/pi-formula/verify-display-capture.png}
run mkdir -p -- "${CAPTURE_DESTINATION%/*}"
run install -m 0644 "$CAPTURE_FILE" "$CAPTURE_DESTINATION"
printf 'キャプチャ: %s\n' "$CAPTURE_DESTINATION"

  trap - ERR
  "$ROOT/scripts/run-display-command" detector detect-display-bands \
    timeout --signal=TERM "$DETECTOR_TIMEOUT" node "$ROOT/scripts/detect-display-bands.js" \
    --background=250,248,240 --body=40,40,35 \
    --ignore=50,100,120 --ignore=80,100,120 --ignore=70,112,70 \
    --ignore=150,60,60 --ignore=140,100,30 --ignore=100,100,96 \
    --ignore=130,130,124 --ignore=180,178,168 --ignore=220,216,202 \
    --ignore=238,235,224 --ignore=232,230,220 --ignore=228,236,224 \
    --ignore=240,226,222 --ignore=232,226,236 "$CAPTURE_FILE" || detector_status=$?
fi
trap - ERR
# 検証不能を帯検出より優先し、両方の判定器が実行できた場合だけ帯検出を統合する。
combined_status=$(run node "$ROOT/scripts/combine-display-status.js" \
  "$stream_detector_status" "$detector_status")
if [[ "$combined_status" -eq 1 ]]; then
  printf 'キャプチャを開いて表示を確認してください: %s\n' "$CAPTURE_DESTINATION" >&2
fi
exit "$combined_status"
