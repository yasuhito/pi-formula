#!/usr/bin/env bash
set -Eeuo pipefail

COMMAND_TIMEOUT=1
OUTPUT_NAME=${1:-}
WINDOW_TITLE=${2:-}
WINDOW_PID=${3:-}
PID_FILE=${4:-}
SCRIPT_DIR=${BASH_SOURCE[0]%/*}
[[ "$SCRIPT_DIR" != "${BASH_SOURCE[0]}" ]] || SCRIPT_DIR=.
ROOT=$(cd -- "$SCRIPT_DIR/.." && pwd)

[[ -n "$OUTPUT_NAME" && -n "$WINDOW_TITLE" ]] || {
  printf 'Usage: cleanup-display <output-name> <window-title> [process-group-id] [pid-file]\n' >&2
  exit 2
}

run() {
  timeout --signal=TERM "$COMMAND_TIMEOUT" "$@"
}

window_pid() {
  local clients
  clients=$(run hyprctl clients -j) || return 2
  printf '%s' "$clients" | run jq -r --arg title "$WINDOW_TITLE" \
    '[.[] | select(.title == $title) | .pid][0] // empty' || return 2
}

window_exists() {
  local clients
  local count
  clients=$(run hyprctl clients -j) || return 2
  count=$(printf '%s' "$clients" | run jq -r --arg title "$WINDOW_TITLE" \
    '[.[] | select(.title == $title)] | length') || return 2
  [[ "$count" -gt 0 ]]
}

group_running() {
  local state
  local states
  [[ "$WINDOW_PID" =~ ^[1-9][0-9]*$ ]] || return 1
  if states=$(run ps -o stat= -g "$WINDOW_PID" 2>/dev/null); then
    :
  else
    ps_status=$?
    [[ "$ps_status" -eq 1 ]] && return 1
    return 2
  fi
  while IFS= read -r state; do
    state=${state#"${state%%[![:space:]]*}"}
    [[ -n "$state" && "$state" != Z* ]] && return 0
  done <<<"$states"
  return 1
}

verification_failed=false
if [[ ! "$WINDOW_PID" =~ ^[1-9][0-9]*$ ]]; then
  for _ in {1..8}; do
    if [[ -n "$PID_FILE" && -s "$PID_FILE" ]]; then
      read -r WINDOW_PID <"$PID_FILE" || WINDOW_PID=
    fi
    if [[ ! "$WINDOW_PID" =~ ^[1-9][0-9]*$ ]]; then
      client_pid=
      if ! client_pid=$(window_pid); then
        verification_failed=true
      fi
      if [[ "$client_pid" =~ ^[1-9][0-9]*$ ]]; then
        pgid=$(run ps -o pgid= -p "$client_pid") || {
          pgid=
          verification_failed=true
        }
        WINDOW_PID=${pgid//[[:space:]]/}
      fi
    fi
    [[ "$WINDOW_PID" =~ ^[1-9][0-9]*$ ]] && break
    run sleep 0.25 || verification_failed=true
  done
fi

if [[ "$WINDOW_PID" =~ ^[1-9][0-9]*$ ]]; then
  timeout --signal=TERM 8 "$ROOT/scripts/stop-display-process" \
    "$WINDOW_PID" "$WINDOW_TITLE" >/dev/null 2>&1 || verification_failed=true
fi
close_window=false
if window_exists; then
  close_window=true
else
  window_status=$?
  if [[ "$window_status" -ne 1 ]]; then
    close_window=true
    verification_failed=true
  fi
fi
if [[ "$close_window" == true ]]; then
  run hyprctl dispatch "hl.dsp.window.close({ window = \"title:${WINDOW_TITLE}\" })" \
    >/dev/null 2>&1 || verification_failed=true
fi

if group_running; then
  kill -KILL -- "-$WINDOW_PID" >/dev/null 2>&1 || verification_failed=true
else
  group_status=$?
  [[ "$group_status" -eq 1 ]] || verification_failed=true
fi

window_gone=false
group_gone=false
for _ in {1..4}; do
  if window_exists; then
    window_gone=false
  else
    window_status=$?
    if [[ "$window_status" -eq 1 ]]; then
      window_gone=true
    else
      window_gone=false
      verification_failed=true
    fi
  fi
  if group_running; then
    group_gone=false
  else
    group_status=$?
    if [[ "$group_status" -eq 1 ]]; then
      group_gone=true
    else
      group_gone=false
      verification_failed=true
    fi
  fi
  [[ "$window_gone" == true && "$group_gone" == true ]] && break
  run sleep 0.25 || verification_failed=true
done

remove_failed=false
run hyprctl output remove "$OUTPUT_NAME" >/dev/null || remove_failed=true
if [[
  "$window_gone" != true ||
    "$group_gone" != true ||
    "$verification_failed" == true ||
    "$remove_failed" == true
]]; then
  printf 'verify-display: 後片付けを完全に確認できませんでした\n' >&2
  exit 2
fi
