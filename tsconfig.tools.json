{
  "compilerOptions": {
    "esModuleInterop": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "strict": true,
    "noImplicitReturns": true,
    "noEmitOnError": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "types": ["node"],
    "sourceMap": true
  },
  "include": ["scripts/**/*.ts", "test/**/*.ts", "features/support/**/*.ts"]
}
